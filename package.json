{
  "name": "script-kill-management",
  "version": "1.0.0",
  "description": "剧本杀门店管理系统后端",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d && echo \"Waiting for database...\" && timeout 30 sh -c 'until docker compose -f docker-compose.test.yml exec -T postgres-test pg_isready -U postgres -d xzwl_test; do sleep 1; done' && echo \"Database ready!\"",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:db:migrate": "dotenv -e .env.test -- npx prisma db push --skip-generate",
    "test:db:reset": "dotenv -e .env.test -- npx prisma migrate reset --force --skip-seed",
    "test:all": "npm run test:db:up && npm run test:db:migrate && npm run test; npm run test:db:down",
    "test:ci": "npm run test:db:up && npm run test:db:migrate && npm run test -- --ci && npm run test:db:down"
  },
  "keywords": [
    "script-kill",
    "management",
    "express",
    "prisma"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.56.0",
    "jest": "^30.4.2",
    "prisma": "^5.10.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
