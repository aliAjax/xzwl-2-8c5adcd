// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXTREME
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  PROFICIENT
  EXPERT
}

enum SessionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum WaitlistStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum SchedulePlanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum MembershipTransactionType {
  RECHARGE
  CONSUME
  REFUND
}

enum MembershipTransactionStatus {
  SUCCESS
  FAILED
  CANCELLED
}

model Store {
  id                Int       @id @default(autoincrement())
  name              String    @unique
  address           String?
  phone             String?
  businessStartTime String?   @default("10:00")
  businessEndTime   String?   @default("23:00")
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  scripts           Script[]
  rooms             Room[]
  hosts             HostStore[]
  sessions          Session[]
  schedulePlans     SchedulePlan[]

  @@index([isActive])
}

model HostStore {
  hostId    Int
  storeId   Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  host      Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([hostId, storeId])
  @@index([storeId])
  @@index([hostId])
}

model Script {
  id           Int               @id @default(autoincrement())
  storeId      Int
  name         String
  description  String?
  minPlayers   Int
  maxPlayers   Int
  durationMin  Int
  difficulty   Difficulty
  coverImage   String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sessions     Session[]
  proficiencies HostProficiency[]
  draftSessions ScheduleDraftSession[]

  @@unique([storeId, name])
  @@index([storeId])
  @@index([isActive])
  @@index([difficulty])
}

model Host {
  id            Int               @id @default(autoincrement())
  name          String
  phone         String            @unique
  avatar        String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  stores        HostStore[]
  sessions      Session[]
  proficiencies HostProficiency[]
  draftSessions ScheduleDraftSession[]

  @@index([isActive])
}

model HostProficiency {
  id        Int               @id @default(autoincrement())
  hostId    Int
  scriptId  Int
  level     ProficiencyLevel
  host      Host              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  script    Script            @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@unique([hostId, scriptId])
  @@index([hostId])
  @@index([scriptId])
}

model Room {
  id         Int       @id @default(autoincrement())
  storeId    Int
  name       String
  capacity   Int
  isActive   Boolean   @default(true)
  remark     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sessions   Session[]
  draftSessions ScheduleDraftSession[]

  @@unique([storeId, name])
  @@index([storeId])
  @@index([isActive])
}

model Session {
  id            Int            @id @default(autoincrement())
  storeId       Int
  scriptId      Int
  hostId        Int
  roomId        Int
  startTime     DateTime
  endTime       DateTime
  status        SessionStatus  @default(PENDING)
  price         Decimal        @db.Decimal(10, 2)
  currentPlayers Int           @default(0)
  maxPlayers    Int
  remark        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  script        Script         @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  host          Host           @relation(fields: [hostId], references: [id], onDelete: Cascade)
  room          Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  waitlists     Waitlist[]

  @@index([storeId])
  @@index([scriptId])
  @@index([hostId])
  @@index([roomId])
  @@index([startTime])
  @@index([status])
  @@index([storeId, startTime, endTime])
}

model Customer {
  id        Int               @id @default(autoincrement())
  name      String
  phone     String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  bookings  Booking[]
  waitlists Waitlist[]
  membershipAccount MembershipAccount?
}

model MembershipAccount {
  id          Int                     @id @default(autoincrement())
  customerId  Int                     @unique
  balance     Decimal                 @db.Decimal(10, 2) @default(0)
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  customer    Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions MembershipTransaction[]

  @@index([customerId])
  @@index([isActive])
}

model MembershipTransaction {
  id              Int                         @id @default(autoincrement())
  accountId       Int
  type            MembershipTransactionType
  amount          Decimal                     @db.Decimal(10, 2)
  balanceAfter    Decimal                     @db.Decimal(10, 2)
  status          MembershipTransactionStatus @default(SUCCESS)
  remark          String?
  operator        String?
  relatedBookingId Int?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  account         MembershipAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  relatedBooking  Booking?                    @relation(fields: [relatedBookingId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([type])
  @@index([status])
  @@index([relatedBookingId])
  @@index([createdAt])
}

model Booking {
  id          Int                     @id @default(autoincrement())
  sessionId   Int
  customerId  Int
  playerCount Int
  status      BookingStatus           @default(PENDING)
  remark      String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  session     Session                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customer    Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  membershipTransactions MembershipTransaction[]

  @@index([sessionId])
  @@index([customerId])
  @@index([status])
}

model Waitlist {
  id          Int            @id @default(autoincrement())
  sessionId   Int
  customerId  Int
  playerCount Int
  status      WaitlistStatus @default(PENDING)
  remark      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  session     Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([customerId])
  @@index([status])
  @@index([sessionId, status, createdAt])
}

model SchedulePlan {
  id             Int                  @id @default(autoincrement())
  storeId        Int
  name           String
  startDate      DateTime
  endDate        DateTime
  status         SchedulePlanStatus   @default(DRAFT)
  remark         String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  store          Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  draftSessions  ScheduleDraftSession[]

  @@index([storeId])
  @@index([status])
  @@index([startDate, endDate])
}

model ScheduleDraftSession {
  id                Int               @id @default(autoincrement())
  schedulePlanId    Int
  scriptId          Int
  hostId            Int
  roomId            Int
  startTime         DateTime
  endTime           DateTime
  price             Decimal           @db.Decimal(10, 2)
  maxPlayers        Int
  remark            String?
  conflictInfo      String?
  proficiencyLevel  ProficiencyLevel?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  schedulePlan      SchedulePlan      @relation(fields: [schedulePlanId], references: [id], onDelete: Cascade)
  script            Script            @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  host              Host              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  room              Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([schedulePlanId])
  @@index([scriptId])
  @@index([hostId])
  @@index([roomId])
}
